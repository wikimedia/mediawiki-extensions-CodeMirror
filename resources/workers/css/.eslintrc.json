{
	"root": true,
	"extends": [
		"plugin:es-x/restrict-to-es2019"
	],
	"env": {
		"worker": true,
		"es2019": true
	},
	"parserOptions": {
		"ecmaVersion": 2019
	},
	"rules": {
		"es-x/no-array-prototype-findlast-findlastindex": 0,
		"es-x/no-array-prototype-at": 0,
		"es-x/no-string-prototype-at": 0
	},
	"settings": {
		"es-x": {
			"aggressive": true
		}
	},
	"overrides": [
		{
			"files": [
				"worker.js"
			],
			"extends": [
				"wikimedia/client",
				"wikimedia/jquery",
				"wikimedia/mediawiki"
			]
		}
	]
}
